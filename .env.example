# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection string (matches docker-compose.yml by default)
DATABASE_URL="postgresql://realtor_user:realtor_password@localhost:5432/realtor_db"

# Admin dashboard
# Pick a strong password, and a random AUTH_SECRET of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD="choose-a-strong-password"
AUTH_SECRET="generate-a-long-random-string-of-32-plus-characters"

# Email (Resend): used to email subscribers when a new listing is published
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="notifications@yourdomain.com"

# Cloudinary: used for listing image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Public site URL, used for SEO metadata, the sitemap and shareable links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI chat assistant -------------------------------------------------------
# Option 1 (recommended for production): Anthropic API.
# Set a monthly spend limit in the Anthropic console as well.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Option 2 (local development, free): Ollama running on your machine.
# Used automatically when ANTHROPIC_API_KEY is empty and NODE_ENV is not production.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# MCP endpoint (/api/mcp): bearer token required by MCP clients
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_TOKEN=""
