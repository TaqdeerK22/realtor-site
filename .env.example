# Postgres connection string (matches docker-compose.yml by default)
DATABASE_URL="postgresql://realtor_user:realtor_password@localhost:5432/realtor_db"

# Admin dashboard
ADMIN_PASSWORD="choose-a-strong-password"
AUTH_SECRET="generate-a-long-random-string"

# Email (Resend) - used for inquiry/subscriber notifications
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="notifications@yourdomain.com"

# Cloudinary - used for listing image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# Public site URL, used for SEO metadata and shareable links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
